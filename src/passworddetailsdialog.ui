/* Bottoni */
QPushButton {
    background-color: #0a84ff;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    min-height: 44px;
    padding: 0px 16px;
    font-size: 15px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #2b95ff;
}
QPushButton:pressed {
    background-color: #0066d6;
}
QPushButton#closeButton {
    background-color: #2c2c2e;
    font-weight: 500;
}
QPushButton#closeButton:hover {
    background-color: #3a3a3c;
}
QPushButton#closeButton:pressed {
    background-color: #48484a;
}
QPushButton#deleteButton {
    background-color: rgba(255, 69, 58, 16%);
    color: #ff453a;
    font-weight: 500;
}
QPushButton#deleteButton:hover {
    background-color: rgba(255, 69, 58, 26%);
}
QPushButton#deleteButton:pressed {
    background-color: rgba(255, 69, 58, 36%);
}

/* Piccoli bottoni dentro le righe */
QPushButton#copyUsernameButton,
QPushButton#togglePasswordButton,
QPushButton#copyPasswordButton {
    background-color: rgba(10, 132, 255, 16%);
    color: #0a84ff;
    border-radius: 8px;
    min-height: 20px;
    padding: 5px 12px;
    font-size: 13px;
}
QPushButton#copyUsernameButton:hover,
QPushButton#togglePasswordButton:hover,
QPushButton#copyPasswordButton:hover {
    background-color: rgba(10, 132, 255, 26%);
}
QPushButton#copyUsernameButton:pressed,
QPushButton#togglePasswordButton:pressed,
QPushButton#copyPasswordButton:pressed {
    background-color: rgba(10, 132, 255, 36%);
}
