   <string notr="true">
QMainWindow, QWidget#centralwidget {
    background-color: #1c1c1e;
}
QLabel {
    color: #ffffff;
}

/* Logo app */
QLabel#logoLabel {
    background-color: transparent;
}
QLabel#titleLabel {
    font-size: 30px;
    font-weight: 700;
}
QLabel#subtitleLabel {
    font-size: 15px;
    color: #98989f;
}

/* Gruppo di campi */
QFrame#card {
    background-color: #2c2c2e;
    border-radius: 12px;
}
QFrame[role="separator"] {
    background-color: #3a3a3c;
    border: none;
    min-height: 1px;
    max-height: 1px;
}
QLabel[role="rowLabel"] {
    color: #ffffff;
    font-size: 14px;
    min-width: 96px;
    max-width: 96px;
    min-height: 48px;
}
QFrame#card QLineEdit {
    background-color: transparent;
    border: none;
    padding: 0px;
    min-height: 48px;
    color: #ffffff;
    font-size: 14px;
    selection-background-color: #0a84ff;
    placeholder-text-color: #636366;
}

/* Bottoni */
QPushButton {
    background-color: #0a84ff;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    min-height: 48px;
    padding: 0px 16px;
    font-size: 15px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #2b95ff;
}
QPushButton:pressed {
    background-color: #0066d6;
}
QPushButton#createAccountButton {
    background-color: transparent;
    color: #0a84ff;
    min-height: 28px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#createAccountButton:hover {
    background-color: transparent;
    color: #5eb0ff;
}
QPushButton#createAccountButton:pressed {
    background-color: transparent;
    color: #0066d6;
}
