   <string notr="true">
QMainWindow, QWidget {
    background-color: #1c1c1e;
    color: #ffffff;
    font-family: "SF Pro Display", "Segoe UI", sans-serif;
}
QPushButton {
    background-color: #0a84ff;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 16px;
    font-size: 14px;
    font-weight: 600;
}
QPushButton:hover { background-color: #0071e3; }
QPushButton#logoutButton {
    background-color: transparent;
    color: #ff453a;
}
QPushButton#logoutButton:hover { color: #ff6961; }
QPushButton#toggleMenuButton {
    background-color: #2c2c2e;
    font-size: 18px;
    min-width: 40px;
    max-width: 40px;
}
QPushButton#passwordsNavButton, QPushButton#authenticatorNavButton {
    background-color: transparent;
    text-align: left;
    padding: 12px 16px;
    font-weight: 500;
}
QFrame#sideMenu {
    background-color: #2c2c2e;
    border-right: 1px solid #3a3a3c;
}
QLineEdit#searchEdit {
    background-color: #2c2c2e;
    border: 1px solid #3a3a3c;
    border-radius: 8px;
    padding: 10px 14px;
    color: #ffffff;
    font-size: 14px;
}
QLineEdit#searchEdit:focus { border: 1px solid #0a84ff; }
QListWidget {
    background-color: #2c2c2e;
    border: none;
    border-radius: 12px;
    padding: 6px;
    color: #ffffff;
    font-size: 15px;
    outline: none;
}
QListWidget::item {
    padding: 12px 14px;
    border-radius: 8px;
}
QListWidget::item:hover { background-color: #3a3a3c; }
QListWidget::item:selected { background-color: #0a84ff; }
QLabel#titleLabel { font-size: 22px; font-weight: 700; }
QLabel#subtitleLabel { font-size: 13px; color: #8e8e93; }
QLabel#menuTitle { font-size: 15px; font-weight: 600; color: #8e8e93; padding: 8px 16px; }
