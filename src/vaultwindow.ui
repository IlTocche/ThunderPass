}

QListWidget {
    background-color: #2c2c2e;
    border: none;
    border-radius: 12px;
    padding: 6px;
    color: #ffffff;
    font-size: 15px;
    outline: none;
}
QListWidget::item {
    padding: 12px 14px;
    border-radius: 8px;
}
QListWidget::item:hover {
    background-color: #3a3a3c;
}
QListWidget::item:selected {
    background-color: #0a84ff;
    color: #ffffff;
}
QListWidget::item:selected:!active {
